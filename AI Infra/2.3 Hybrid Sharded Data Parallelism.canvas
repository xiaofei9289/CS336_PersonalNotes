		{"id":"14f81dd51d09f1a9","type":"text","text":"再次All-Gather：重新收集所有GPU完整Block1参数分片W1","x":1091,"y":11522,"width":352,"height":61},
		{"id":"0e55bb2e022a0120","type":"text","text":"Reduce-Scatter：跨 GPU 聚合梯度，并按参数分片方式分配","x":895,"y":12081,"width":219,"height":89},
		{"id":"0422714381cdd36d","type":"text","text":"各 GPU 使用dH1、完整的W1和必要激活执行Backward1的本地Backward","x":1091,"y":11644,"width":352,"height":61},
		{"id":"53c4617d2c1dac21","type":"text","text":"再次All-Gather：重新收集所有GPU完整Block2参数分片W2","x":116,"y":10412,"width":352,"height":61},
		{"id":"51521421e5355e3c","type":"text","text":"各 GPU 使用dH2、完整W2和所需激活执行Block2 本地Backward","x":116,"y":10514,"width":352,"height":61},
		{"id":"171fbb9d82ed3c8a","type":"text","text":"Block 2 接收上游梯度 dH2","x":116,"y":10099,"width":352,"height":56},
		{"id":"fef3355760eee149","type":"text","text":"问题：反向计算需要W2和前向保存的激活","x":116,"y":10199,"width":352,"height":61},
		{"id":"9c82faa63282dead","type":"text","text":"完成forward后已经释放临时完整的W2","x":116,"y":10304,"width":352,"height":61},
		{"id":"1a22564c85f43de8","type":"text","text":"当前计算暂时不再需要完整 W1","x":-341,"y":7210,"width":250,"height":60},
		{"id":"83a6b43b4c065556","type":"text","text":"不同 GPU 的本地 dW2_local 需要跨GPU 聚合","x":-73,"y":10958,"width":219,"height":92},
		{"id":"b1fdf40b9576e86a","type":"text","text":"dH1 继续传给本GPU的Block 1，用于继续计算 Block 1的梯度","x":193,"y":10958,"width":213,"height":92},
		{"id":"034e8d6db5a622ab","type":"text","text":"保留 Backward 所需的激活信息供之后的backward计算 dW1 和 dH0","x":-375,"y":6880,"width":318,"height":90},
		{"id":"864c115d5a7b9806","type":"text","text":"Reduce-Scatter：跨 GPU 聚合梯度，并按参数分片方式分配","x":-73,"y":11082,"width":219,"height":86},
		{"id":"a266146a533ba110","type":"text","text":"进入 Block 2 Forward","x":-341,"y":7843,"width":250,"height":60,"color":"1"},
		{"id":"4ec97188e1979064","type":"text","text":"继续保留完整 W1","x":-182,"y":7537,"width":250,"height":60},
		{"id":"fbbb342b58a1d2fd","type":"text","text":"减少通信","x":-182,"y":7663,"width":250,"height":60},
		{"id":"069b7198775fd61e","type":"text","text":"各 GPU 保留对应的 聚合梯度分dW1_shard，Optimizer 使用dW1_shard更新对应的 W1_shard","x":895,"y":12377,"width":219,"height":143},
		{"id":"764ba9da78bb1841","type":"text","text":"所有可训练模块的Backward完成，所需的梯度同步与分片完成","x":916,"y":12882,"width":352,"height":88},
		{"id":"e3c25c28c26c4ba7","type":"text","text":"保留 dW2 分片，暂不更新 W2","x":-109,"y":12319,"width":292,"height":115},
		{"id":"28ef41cacbcb6ffb","type":"text","text":"完成当前模块block1 的forward计算","x":-375,"y":7033,"width":318,"height":50},
		{"id":"0e93e1f0693f165d","type":"text","text":"按配置决定是否 Reshard W1（即是否释放完整w1）","x":-341,"y":7335,"width":250,"height":60},
		{"id":"f70a441d9378d509","type":"text","text":"不同 GPU 的本地 dW2_local 需要跨GPU 聚合","x":895,"y":11946,"width":219,"height":84},
		{"id":"3fb65e5b04bbb98e","type":"text","text":"输出：每张 GPU得到自己的聚合梯度分片dW1_shard","x":895,"y":12219,"width":219,"height":100},
		{"id":"3b1237c5ca0fcb20","type":"text","text":"每张GPU拥有其负责参数对应的梯度分片，包括W1，W2与其他可训练模块","x":916,"y":13047,"width":352,"height":61},
		{"id":"6933f74db98b2c1d","type":"text","text":"节省显存","x":-481,"y":7663,"width":250,"height":60},
		{"id":"a47bbcedc56132b6","type":"text","text":"使用本地优化器状态和梯度分片，计算参数更新，每个Rank更新自己的参数分片及优化器状态","x":916,"y":13187,"width":352,"height":105},
		{"id":"5e80b74f439b8b40","type":"text","text":"不同复制组中，对应的参数分片保持一致","x":916,"y":13367,"width":352,"height":61},
		{"id":"d56205ba2a0837c6","type":"text","text":"清理梯度并进入下一轮训练","x":916,"y":13519,"width":352,"height":61},
		{"id":"84e1fb4e6b9a0579","type":"text","text":"Block2 开始进行反向计算","x":116,"y":9990,"width":352,"height":61},
		{"id":"caeeac0df32773a8","type":"text","text":"Block 1 接收来自 Block 2 的上游梯度dH1","x":1091,"y":11180,"width":352,"height":61},
		{"id":"9e4f256e56e01adb","type":"text","text":"开始 Block 1 层Forward","x":-392,"y":5890,"width":352,"height":64},
		{"id":"956e0c7dc31696be","type":"text","text":"各 GPU 计算本地完整参数梯度dW2_local","x":-73,"y":10836,"width":219,"height":61},
		{"id":"563c28c3e37a8dcb","type":"text","text":"产生输入梯度dH1","x":193,"y":10836,"width":213,"height":61},
		{"id":"29ec8016d95f5de7","type":"text","text":"后续Transformer Block3至Block N：依次重复All-Gather → 本地forward → Reshard","x":159,"y":8613,"width":352,"height":87},
		{"id":"b7826caa8ba8e5f1","type":"text","text":"得到最后一个Block输出 H_final","x":159,"y":8758,"width":352,"height":61},
		{"id":"6d9707c2ff2e0d88","type":"text","text":"各 GPU 计算本地完整参数梯度dW1_local","x":895,"y":11824,"width":219,"height":61},
		{"id":"d08f221c2634cd4b","type":"text","text":"输入Token IDs经过Embedding得到X","x":-364,"y":5334,"width":297,"height":84},
		{"id":"7d8abdac5d675e88","type":"text","text":"训练就绪：模型状态已分片，优化器与数据管线已准备","x":-365,"y":4680,"width":299,"height":102},
		{"id":"d22fa93988583821","type":"text","text":"取当前Global Batch：8条样本","x":-364,"y":4850,"width":299,"height":83},
		{"id":"0b56727e465ea6b6","type":"text","text":"4张GPU各拿2个不同样本：Local Batch = 2","x":-365,"y":5013,"width":299,"height":85},
		{"id":"f3cfdad81e231938","type":"text","text":"把本地input_ids、labels放置到本GPU","x":-365,"y":5170,"width":298,"height":85}
	],
