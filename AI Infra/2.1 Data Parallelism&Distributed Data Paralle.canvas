		{"id":"a9ee305ad10f5c98","type":"text","text":"GPU 0: 完整模型 + local batch 1  (4条数据)","x":552,"y":1272,"width":300,"height":67},
		{"id":"86a524eba4237ab0","type":"text","text":"Local Batch","x":-485,"y":999,"width":299,"height":60},
		{"id":"ebcab68232f084f2","type":"text","text":"Micro-batches","x":-485,"y":1177,"width":299,"height":67},
		{"id":"dd1806aa1f179930","type":"text","text":"dataset被划分为多个Global Batch","x":728,"y":435,"width":347,"height":59},
		{"id":"21d0590b2bc6cfc5","type":"text","text":"使用DDP训练模型","x":758,"y":137,"width":288,"height":60},
		{"id":"79e156c01a2a37a2","type":"text","text":"训练数据集 Dataset","x":758,"y":246,"width":288,"height":66},
		{"id":"44d31f8fa1e1a104","type":"text","text":"每个global batch: 8条数据","x":603,"y":584,"width":600,"height":85},
		{"id":"eef32e2590f6c3ac","type":"text","text":"每个global batch 划分成多个 local batch","x":603,"y":729,"width":600,"height":78},
		{"id":"a7043afeb171a047","type":"text","text":"local batch 1： 4条数据","x":603,"y":874,"width":250,"height":60},
		{"id":"883645efce36edb6","type":"text","text":"local batch 2： 4条数据","x":947,"y":874,"width":256,"height":60},
		{"id":"c9594aefeea215c9","type":"text","text":"GPU 1: 完整模型 + local batch 2 （4条数据）","x":946,"y":1272,"width":309,"height":67},
		{"id":"194ea9c51b4810ce","type":"text","text":"GPU 1：Forward + Backward","x":946,"y":1426,"width":309,"height":67},
		{"id":"1f4f1e59a2d13481","type":"text","text":"前提条件：单个GPU能容纳完整模型及训练状态","x":-638,"y":-717,"width":288,"height":75},
		{"id":"fd33b6dc3cfc7929","type":"text","text":"核心问题：训练数据量多，单个GPU处理耗时长","x":-638,"y":-570,"width":288,"height":75},
		{"id":"e9bb1a3c9e7f0805","type":"text","text":"问题本质：训练样本过多，单卡训练吞吐量不足","x":-638,"y":-402,"width":288,"height":75},
		{"id":"bc44c04bb2390bb4","type":"text","text":"模型复制：每张GPU保存完整模型","x":1046,"y":-469,"width":201,"height":60},
		{"id":"cf94ec06617ff6ec","type":"text","text":"解决思路：把训练数据拆分，多个GPU同时处理训练数据","x":1144,"y":-691,"width":404,"height":75},
		{"id":"2378ead38223d67c","type":"text","text":"数据拆分：不同GPU处理不同训练数据","x":1247,"y":-469,"width":201,"height":62},
		{"id":"fb6eb4c5482ea90a","type":"text","text":"每个GPU独立完成前向训练和反向训练","x":1448,"y":-469,"width":201,"height":62},
		{"id":"50a8296797bd84ba","type":"text","text":"**Data Parallelism(DP)**","x":151,"y":-1078,"width":250,"height":60},
		{"id":"05156fb404e9dd59","type":"text","text":"单位时间处理更多数据","x":-702,"y":3812,"width":274,"height":64},
		{"id":"c5f74094f1d39935","type":"text","text":"一次参数更新可使用更多样本","x":-355,"y":3972,"width":286,"height":64},
		{"id":"c03a76b1ea2a7702","type":"text","text":"同步等待与扩展效率","x":780,"y":3521,"width":250,"height":60},
		{"id":"c4416ee72a45cf8a","type":"text","text":"不同GPU的完成时间可能不同","x":780,"y":3630,"width":250,"height":60},
		{"id":"f40c739d11fdab03","type":"text","text":"完整训练状态超过单卡显存","x":186,"y":4004,"width":250,"height":60},
		{"id":"9d03b01b0f906247","type":"text","text":"DDP无法通过增加GPU数量解决","x":186,"y":4123,"width":250,"height":60},
		{"id":"60414db6e0421f1f","type":"text","text":"需要改变模型状态的存储方式","x":186,"y":4230,"width":250,"height":60},
		{"id":"1d9aef4d507e8bac","type":"text","text":"把模型状态分片到不同GPU","x":186,"y":4340,"width":250,"height":60},
		{"id":"7d08538f1318b8e9","type":"text","text":"引出 FSDP：分片模型状态","x":186,"y":4464,"width":250,"height":60,"color":"2"},
		{"id":"2051dbb61fb87fd9","type":"text","text":"支持更大的 Global Batch","x":-351,"y":3518,"width":278,"height":60},
		{"id":"924d0a374ca72f0e","type":"text","text":"每张 GPU 仅处理 Local Batch","x":-351,"y":3660,"width":278,"height":55},
		{"id":"61d7a4d2a65ef5e9","type":"text","text":"梯度分桶及计算通信重叠可缓解开销","x":478,"y":3976,"width":250,"height":60},
		{"id":"cc7b9e29902a0a85","type":"text","text":"较快GPU需要等待较慢GPU","x":780,"y":3752,"width":250,"height":60},
		{"id":"e89da2a43254ec58","type":"text","text":"通信及等待降低实际加速比","x":780,"y":3876,"width":250,"height":60},
		{"id":"7019f1eef0fe4f6b","type":"text","text":"增加GPU不保证线性加速","x":780,"y":3976,"width":250,"height":60},
		{"id":"0cbf6f273144d307","type":"text","text":"不同GPU计算出不同梯度","x":478,"y":3630,"width":250,"height":60},
		{"id":"4df74425d00cacdd","type":"text","text":"每张GPU保存完整模型状态","x":186,"y":3630,"width":250,"height":60},
		{"id":"9042f3dbeb36c1c3","type":"text","text":"模型及训练状态重复存储","x":186,"y":3521,"width":250,"height":60},
		{"id":"b1fd23e894eca83a","type":"text","text":"梯度同步通信开销","x":478,"y":3521,"width":250,"height":60},
		{"id":"164fadae6d4dd46b","type":"text","text":"Global Batch = Local Batch ×GPU 数量","x":-351,"y":3807,"width":278,"height":69},
		{"id":"2014b7658dde53c8","type":"text","text":"提高训练吞吐量","x":-702,"y":3518,"width":274,"height":60},
		{"id":"1a9bc9954f682708","type":"text","text":"多 GPU 同时处理不同的数据","x":-702,"y":3660,"width":274,"height":55},
		{"id":"d2f2f75e1ef5a850","type":"text","text":"DDP收益","x":-521,"y":3356,"width":250,"height":60},
		{"id":"cf696c5a64fbaab7","type":"text","text":"使用All-Reduce合并梯度","x":478,"y":3752,"width":250,"height":60},
		{"id":"904a0ee12ae8dfbb","type":"text","text":"GPU之间通信消耗时间和网络带宽","x":478,"y":3876,"width":250,"height":60},
		{"id":"c70084479f80c22c","type":"text","text":"每张GPU保存梯度和优化器状态","x":186,"y":3752,"width":250,"height":60},
		{"id":"b818a699c5f6a2b0","type":"text","text":"模型规模增大，显存需求增加","x":186,"y":3876,"width":250,"height":60},
		{"id":"58e236e0ff9d8d24","type":"text","text":"DDP收益与代价","x":-105,"y":3105,"width":250,"height":60},
		{"id":"bc49fbb265a198b9","type":"text","text":"各个GPU上模型参数保持一致","x":603,"y":2571,"width":815,"height":97},
		{"id":"72ee9c016d25a4dc","type":"text","text":"各 GPU 执行 Optimizer Step","x":706,"y":2404,"width":398,"height":81},
		{"id":"c7fed0849c85b542","type":"text","text":"问题：不同训练样本产生不同梯度","x":707,"y":1838,"width":395,"height":71},
		{"id":"dfd8c1786895ef49","type":"text","text":"All-Reduce：同步并平均梯度","x":707,"y":1989,"width":396,"height":80},
		{"id":"fb2fb480c1aa0050","type":"text","text":"两张 GPU 获得相同的平均梯度","x":707,"y":2158,"width":398,"height":70},
