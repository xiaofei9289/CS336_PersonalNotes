{
	"nodes":[
		{"id":"3ef47028be6c8029","type":"group","x":-707,"y":-2792,"width":2595,"height":971,"color":"5","label":"重点分摊显存与计算负担"},
		{"id":"5a6b238f799ac26e","type":"group","x":-3776,"y":-1869,"width":1943,"height":805,"color":"6","label":"通信基础"},
		{"id":"678ffbc826e56c94","type":"group","x":-1337,"y":-1607,"width":3225,"height":305,"color":"3","label":"GPU之间通信"},
		{"id":"163164c68a929823","type":"group","x":-1245,"y":-2706,"width":3014,"height":262,"label":"问题瓶颈"},
		{"id":"b6665c27db9b22c6","type":"group","x":-1245,"y":-2181,"width":3014,"height":193,"label":"解决思路"},
		{"id":"c9ca142e036ed4a3","type":"group","x":-1337,"y":-2792,"width":540,"height":970,"color":"4","label":"重点提高吞吐量和 GPU 利用率"},
		{"id":"7dca1f7c57635f13","type":"group","x":-1245,"y":-2372,"width":3014,"height":119,"label":"问题本质"},
		{"id":"07178554b2f1b4cb","type":"text","text":"EP 将不同专家放到不同 GPU，并将 Token 路由到对应专家；ETP 可进一步拆分单个专家的计算。","x":1493,"y":-2161,"width":250,"height":139},
		{"id":"8a2440da8b58ea7c","type":"text","text":"将模型状态分片保存，计算时按需收集参数。","x":-562,"y":-2161,"width":250,"height":139},
		{"id":"a2ff2afd18d5bdf6","type":"text","text":"Hybrid Sharded Data Parallel","x":-437,"y":-1902,"width":250,"height":60},
		{"id":"421ef32714cfcd23","type":"text","text":"沿序列维度切分 Token，在 GPU 之间交换必要的 KV 数据，协同完成 Attention。","x":956,"y":-2161,"width":250,"height":139},
		{"id":"c8a221cc5bc9f28e","type":"text","text":"将层内Linear 权重矩阵、 Attention Heads 、MLP权重矩阵分给不同 GPU 并行计算。","x":-31,"y":-2161,"width":250,"height":139},
		{"id":"ae6e1709b84dda6b","type":"text","text":"Tensor Parallelism","x":-31,"y":-1902,"width":250,"height":60},
		{"id":"c9db63ac02d7f12d","type":"text","text":"不同 GPU 保存不同层","x":469,"y":-2161,"width":250,"height":139},
		{"id":"29b049b0b7fae61b","type":"text","text":"单 GPU 训练吞吐量不足","x":-1192,"y":-2352,"width":250,"height":60},
		{"id":"f7ec1d6153db2aa3","type":"text","text":"Pipeline Parallelism","x":469,"y":-1902,"width":250,"height":60},
		{"id":"693a8dd6852b461b","type":"text","text":"Context Parallelism","x":956,"y":-1902,"width":250,"height":60},
		{"id":"8294aaf0d96d830d","type":"text","text":"多 GPU 保存完整模型副本，并行处理不同数据，同步梯度","x":-1192,"y":-2161,"width":250,"height":139},
		{"id":"6a3154820fe14377","type":"text","text":"单层显存占用和计算负担过高。","x":-31,"y":-2352,"width":250,"height":60},
		{"id":"4e54796c8a1f716c","type":"text","text":"模型状态显存开销过高，单 GPU 显存容量受限。","x":-562,"y":-2352,"width":250,"height":60},
		{"id":"42230cc455fcc70d","type":"text","text":"多专家模型的参数容量、显存压力和专家计算负载。","x":1493,"y":-2352,"width":250,"height":60},
		{"id":"7ceab19693c882a0","type":"text","text":"模型层级容量与计算","x":469,"y":-2352,"width":250,"height":60},
		{"id":"485ceb39e0ddd130","type":"text","text":"长序列带来的激活显存压力和 Attention 计算负担。","x":956,"y":-2352,"width":250,"height":60},
		{"id":"8b2ecdf6daf4abc9","type":"text","text":"模型参数、梯度和优化器状态占用显存过大","x":-562,"y":-2597,"width":250,"height":133},
		{"id":"69a5dd5d8b966e9c","type":"text","text":"输入序列太长，Attention 相关的显存和计算开销过大。","x":956,"y":-2597,"width":250,"height":133},
		{"id":"359e2bb07f649ae7","type":"text","text":"Fully Sharded Data Parallel","x":-687,"y":-1902,"width":250,"height":60},
		{"id":"bcd213eae8bec487","type":"text","text":"本质：根据显存、计算和通信等不同的瓶颈，将数据、模型状态、层内张量、网络层、序列或专家分配到多个GPU上，以实现单张GPU无法高效完成的大模型训练","x":-129,"y":-3656,"width":437,"height":93},
		{"id":"aed87b80ea34685a","type":"text","text":"##### 分布式训练","x":-558,"y":-3639,"width":250,"height":60,"color":"1"},
		{"id":"a4f366ff19f5d63a","type":"text","text":"训练数据规模大，单 GPU 训练耗时长","x":-1192,"y":-2597,"width":250,"height":133},
		{"id":"430bd09373b2aa0f","type":"text","text":"MoE 专家数量多，专家参数占用显存大，单 GPU 难以高效存储和处理。","x":1493,"y":-2597,"width":250,"height":133},
		{"id":"e7d3d7fb064a84c8","type":"text","text":"Distributed Data Parallel","x":-1067,"y":-1902,"width":250,"height":60},
		{"id":"fe562d75f76e6bcc","type":"text","text":"Expert Tensor Parallelism","x":1618,"y":-1901,"width":250,"height":60},
		{"id":"5f2f0b0611ece7f0","type":"text","text":"单层权重矩阵规模大，或 Attention 计算规模大","x":-31,"y":-2597,"width":250,"height":133},
		{"id":"fb000b35a60c5315","type":"text","text":"模型网络层数太多，单张 GPU 无法容纳整个模型","x":469,"y":-2597,"width":250,"height":133},
		{"id":"c55853ab619f109f","type":"text","text":"目的2：突破资源限制","x":-370,"y":-3177,"width":250,"height":60},
		{"id":"ebde4856f39041c3","type":"text","text":"目的1：提高训练速度","x":-776,"y":-3177,"width":250,"height":60},
		{"id":"13b69ed3827a6b53","type":"text","text":"使用GPU集群进行大模型训练","x":-586,"y":-3389,"width":303,"height":60},
		{"id":"a52986cc81a604ac","type":"text","text":"反向传播：局部梯度+跨阶段输入梯度","x":-710,"y":593,"width":250,"height":60},
		{"id":"5247b3e4e99bc590","type":"text","text":"前向传播：TP层内协作+PP跨阶段传递","x":-710,"y":479,"width":250,"height":59},
		{"id":"9a3fd98cf05e078a","type":"text","text":"同步梯度：DP All-Reduce","x":-710,"y":704,"width":250,"height":60},
		{"id":"c6b69767c24df4a6","type":"text","text":"更新参数：optimizer.step","x":-710,"y":805,"width":250,"height":60},
		{"id":"c30cb27f39ca6372","type":"text","text":"显存仍然紧张","x":-1131,"y":139,"width":250,"height":60},
		{"id":"77a51c56304eba93","type":"text","text":"# 逻辑关系","x":-704,"y":-809,"width":238,"height":105,"color":"1"},
		{"id":"d7810a46afb04c87","type":"text","text":"按照层内矩阵拆分","x":-312,"y":-421,"width":250,"height":60},
		{"id":"3b93cc5ca1828bee","type":"text","text":"模型部分：按照模型层阶段拆分","x":-710,"y":-421,"width":250,"height":60},
		{"id":"7671093871f722ad","type":"text","text":"Pipeline Parallelism","x":-710,"y":-296,"width":250,"height":60},
		{"id":"e9f4438c238b963f","type":"text","text":"问题：模型大，数据多，单卡算力和显存资源有限","x":-801,"y":-625,"width":432,"height":92},
		{"id":"6d7c93b28e688f8d","type":"text","text":"3D 并行(DP+PP+TP)","x":-801,"y":-37,"width":432,"height":92},
		{"id":"aec882a98e37c399","type":"text","text":"定位进程：Rank+Shape+Stride","x":-710,"y":253,"width":250,"height":60},
		{"id":"720bda6ec8ef4a2e","type":"text","text":"组织设备：device mesh","x":-710,"y":139,"width":250,"height":59},
		{"id":"a5e20f45d9e72824","type":"text","text":"找到通信组：TP/PP/DP  Process Groups","x":-710,"y":364,"width":250,"height":60},
		{"id":"45b16a441a787a69","type":"text","text":"引入FSDP分片模型状态","x":-1131,"y":364,"width":250,"height":60},
		{"id":"1ea3de6065324ce0","type":"text","text":"All-Reduce","x":-1192,"y":-1540,"width":250,"height":125},
		{"id":"a52ca22b8bba9af6","type":"text","text":"All-Gather + Reduce-Scatter","x":-687,"y":-1540,"width":250,"height":125},
		{"id":"424e733e3ae6cc2b","type":"text","text":"GPU通信：P2P Send/Recv\n1. 前向：发送Activation\n2. 反向：发送Activation Gradient","x":276,"y":-1540,"width":319,"height":125},
		{"id":"0c83a163a57b9cdb","type":"text","text":"组内AG/RS + 组间AR","x":-437,"y":-1540,"width":250,"height":125},
		{"id":"8303318328f9226f","type":"text","text":"层内集合通信：\n1. All-Reduce\n2. Reduce-Scatter\n3. All-Gather","x":-31,"y":-1540,"width":250,"height":125},
		{"id":"b10d89bb7c8c8596","type":"text","text":"**Rank**：每个分布式进程的编号，通常一个进程控制一张 GPU。","x":-3756,"y":-1849,"width":519,"height":84},
		{"id":"3e3b58555b64e70b","type":"text","text":"AG = All-Gather，RS = Reduce-Scatter，AR = All-Reduce。","x":-1317,"y":-1382,"width":574,"height":60},
		{"id":"2c3cbce15f033956","type":"text","text":"Tensor Parallelism","x":-312,"y":-296,"width":250,"height":60},
		{"id":"2222c5023ae05336","type":"text","text":"Data Parallelism","x":-1317,"y":-1902,"width":250,"height":60},
		{"id":"a49a9936a4672f12","type":"text","text":"Expert Parallelism","x":1368,"y":-1901,"width":250,"height":60},
		{"id":"17f1a2cbc2cabbd6","type":"text","text":"流水线调度：Micro-batch -> GPipe -> 1F1B -> Zero-Bubble -> DualPipe","x":594,"y":-1540,"width":310,"height":125},
		{"id":"102e1467573457b0","type":"text","text":"1. EP: Token All-to-All\n2. Expert内部TP通信","x":1493,"y":-1540,"width":250,"height":125},
		{"id":"018de606ae583385","type":"text","text":"1. KV All-Gather\n2. Ring P2P KV Exchange","x":956,"y":-1540,"width":250,"height":125},
		{"id":"4dc2db6eff499dbd","type":"text","text":"**Process Group**：需要互相协作的一组进程。","x":-3085,"y":-1849,"width":526,"height":84},
		{"id":"c3dc7e6c19d5d826","type":"text","text":"Rank / Process Group / DeviceMesh","x":-2997,"y":-1606,"width":351,"height":85},
		{"id":"85d01410bde5bbd3","type":"text","text":"确定哪些GPU组成通信组","x":-2997,"y":-1379,"width":351,"height":90},
		{"id":"3d896234213093a4","type":"text","text":"执行GPU之间的通信","x":-2997,"y":-1174,"width":351,"height":90},
		{"id":"51cf4fa3252b5dea","type":"text","text":"**DeviceMesh**：把所有 GPU 组织成一个多维坐标系，方便定义哪些设备参与 TP、PP、DP 等操作。","x":-2379,"y":-1849,"width":526,"height":84},
		{"id":"5ff01275cf14f965","type":"text","text":"Data Parallelism","x":-1178,"y":-296,"width":250,"height":60},
		{"id":"7af695208e414fdd","type":"text","text":"数据部分：按照数据拆分","x":-1178,"y":-421,"width":250,"height":60},
		{"id":"7671a003f20c7f12","x":-476,"y":-4272,"width":830,"height":472,"color":"5","type":"text","text":"**第一阶段：为什么需要分布式训练？**\n\n**吞吐量、模型状态显存、激活显存、单层计算、长序列、MoE**\n\n**第二阶段：针对瓶颈，选择拆分策略**\n\n**DP / DDP / FSDP / HSDP / TP / PP / SP / CP / EP**\n\n**第三阶段：拆分后，GPU 如何协作？**\n\n**Rank、Process Group、DeviceMesh、通信原语**\n\n**第四阶段：多种并行技术如何组合？**\n\n**DP × TP × PP，以及状态分片、SP、CP、EP 等组合**\n\n**第五阶段：如何执行一次完整训练？**\n\n**数据分配 → Forward → Loss → Backward → 梯度同步 → Optimizer Step**"}
	],
